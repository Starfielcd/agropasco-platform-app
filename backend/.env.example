# ============================================
# AgroPasco - Variables de Entorno (EJEMPLO)
# ============================================
# Copia este archivo como .env y reemplaza los valores:
#   cp .env.example .env

# Servidor
PORT=5000
NODE_ENV=development

# JWT Secret (cambiar en producción por una clave segura)
JWT_SECRET=tu_clave_secreta_jwt_aqui

# OpenWeatherMap API (opcional)
# Obtén tu key gratis en: https://openweathermap.org/api
WEATHER_API_KEY=tu_api_key_aqui

# Ubicación por defecto (Cerro de Pasco)
DEFAULT_LAT=-10.6868
DEFAULT_LON=-76.2625
DEFAULT_CITY=Cerro de Pasco,PE

# Base de datos
DB_PATH=./agropasco.db

# Proveedor de Mapas
# Opciones: 'leaflet' (gratuito, por defecto) | 'google' (requiere API key)
MAPS_PROVIDER=leaflet

# Google Maps API Key (solo si MAPS_PROVIDER=google)
# Obtén tu key en: https://console.cloud.google.com/
# APIs requeridas: Maps JavaScript API, Geocoding API, Directions API
MAPS_API_KEY=tu_google_maps_api_key_aqui
